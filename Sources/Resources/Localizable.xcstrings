        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos will no longer be sent to fal.ai, Google or OpenAI. You can grant consent again at your next try-on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Fotos werden nicht mehr an fal.ai, Google oder OpenAI gesendet. Sie können die Einwilligung bei der nächsten Anprobe erneut erteilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos ya no se enviarán a fal.ai, Google ni OpenAI. Puedes volver a concederlo en tu próxima prueba."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
