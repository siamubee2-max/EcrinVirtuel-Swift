    "tryOnUI.consentProviderPolicies": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous demandons à fal.ai de ne pas conserver les données envoyées. Au-delà, chaque prestataire applique sa propre politique de confidentialité, détaillée dans la nôtre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We ask fal.ai not to retain the data we send. Beyond that, each provider applies its own privacy policy, detailed in ours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir fordern fal.ai auf, die gesendeten Daten nicht zu speichern. Darüber hinaus gilt für jeden Dienstleister seine eigene Datenschutzerklärung, die in unserer erläutert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedimos a fal.ai que no conserve los datos enviados. Más allá de eso, cada proveedor aplica su propia política de privacidad, detallada en la nuestra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiediamo a fal.ai di non conservare i dati inviati. Oltre a questo, ogni fornitore applica la propria informativa sulla privacy, illustrata nella nostra."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedimos à fal.ai que não conserve os dados enviados. Além disso, cada fornecedor aplica a sua própria política de privacidade, detalhada na nossa."
          }
        }
      }
    },
    "tryOnUI.consentRecipients": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photo est envoyée à nos prestataires d'IA : fal.ai (principal), puis Google Gemini ou OpenAI si fal.ai est indisponible."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photo is sent to our AI providers: fal.ai (primary), then Google Gemini or OpenAI if fal.ai is unavailable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Foto wird an unsere KI-Dienstleister gesendet: fal.ai (primär), dann Google Gemini oder OpenAI, falls fal.ai nicht verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto se envía a nuestros proveedores de IA: fal.ai (principal) y, si fal.ai no está disponible, Google Gemini u OpenAI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua foto viene inviata ai nostri fornitori di IA: fal.ai (principale), poi Google Gemini o OpenAI se fal.ai non è disponibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua fotografia é enviada aos nossos fornecedores de IA: fal.ai (principal) e, se fal.ai estiver indisponível, Google Gemini ou OpenAI."
          }
        }
      }
    },
