        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a L'Écrin Virtuel y da a conocer tus joyas artesanales a miles de apasionados. Solicitud gratuita, respuesta en 72 h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez L'Écrin Virtuel et faites découvrir vos bijoux artisanaux à des milliers de passionné·es. Candidature gratuite, réponse sous 72 h."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a L'Écrin Virtuel e fai scoprire i tuoi gioielli artigianali a migliaia di appassionati. Candidatura gratuita, risposta entro 72 ore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Junte-se a L'Écrin Virtuel e dê a conhecer as suas joias artesanais a milhares de apaixonados. Candidatura gratuita, resposta no prazo de 72 h."
          }
        }
      }
