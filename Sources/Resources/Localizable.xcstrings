    "weatherUI.locationPrivacyNotice": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel verwendet Ihren Standort, um Ihnen einen Look passend zum Wetter in Ihrer Stadt vorzuschlagen. Ihre Koordinaten werden niemals auf unseren Servern gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel uses your location to suggest a look suited to the weather in your city. Your coordinates are never stored on our servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel utiliza tu ubicación para proponerte un look adaptado al clima de tu ciudad. Tus coordenadas nunca se almacenan en nuestros servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel utilise votre position pour vous proposer un look adapté à la météo de votre ville. Vos coordonnées ne sont jamais stockées sur nos serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel utilizza la tua posizione per proporti un look adatto al meteo della tua città. Le tue coordinate non vengono mai memorizzate sui nostri server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel utiliza a sua localização para lhe propor um look adequado à meteorologia da sua cidade. As suas coordenadas nunca são armazenadas nos nossos servidores."
          }
        }
      }
    },
