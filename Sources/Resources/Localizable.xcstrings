    "home.tryOnDescription": {
      "comment": "home › tryOnDescription",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie ein Schmuckstück, wählen Sie Ihr Foto und lassen Sie die Magie wirken. Visualisieren Sie das Ergebnis vor dem Kauf oder einfach zum Träumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a piece of jewelry, choose your photo, and let the magic happen. See the result before buying or just to dream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa una joya, elige tu foto y deja que la magia suceda. Visualiza el resultado antes de comprar o solo para soñar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un bijou, choisissez votre photo, et laissez la magie opérer. Visualisez le résultat avant d'acheter ou juste pour rêver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un gioiello, scegli la tua foto e lascia che la magia accada. Visualizza il risultato prima di acquistare o semplicemente per sognare."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe uma joia, escolha sua foto e deixe a magia acontecer. Visualize o resultado antes de comprar ou apenas para sonhar."
          }
        }
      }
    },
