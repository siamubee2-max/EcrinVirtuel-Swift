    "profileUI.deleteAccountWarning": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ihre Daten werden endgültig gelöscht: gespeicherte Looks, Anprobe-Verlauf und persönliche Informationen. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your data will be permanently deleted: saved looks, try-on history and personal information. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus datos se eliminarán definitivamente: looks guardados, historial de pruebas e información personal. Esta acción es irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vos données seront supprimées définitivement : looks sauvegardés, historique d'essayage et informations personnelles. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi dati verranno eliminati definitivamente: look salvati, cronologia delle prove e informazioni personali. Questa azione è irreversibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus dados serão eliminados definitivamente: looks guardados, histórico de provas e informações pessoais. Esta ação é irreversível."
          }
        }
      }
    },
    "profileUI.deleteFailedNothingDeleted": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung ist fehlgeschlagen — es wurden keine Daten gelöscht. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut, oder kontaktieren Sie support@inferencevision.store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deletion failed — no data was deleted. Check your connection and try again, or contact support@inferencevision.store."
