    "stylisteUI.consentData": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données envoyées : votre garde-robe (pièces, couleurs, marques), la météo de votre position, votre budget et le style recherché. Aucune photo, aucune adresse précise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data sent: your wardrobe (items, colours, brands), the weather at your location, your budget and your preferred style. No photos, no precise address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesendete Daten: Ihre Garderobe (Teile, Farben, Marken), das Wetter an Ihrem Standort, Ihr Budget und Ihr bevorzugter Stil. Keine Fotos, keine genaue Adresse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos enviados: tu armario (prendas, colores, marcas), el tiempo en tu ubicación, tu presupuesto y el estilo que buscas. Ninguna foto, ninguna dirección exacta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati inviati: il tuo guardaroba (capi, colori, marchi), il meteo della tua posizione, il tuo budget e lo stile desiderato. Nessuna foto, nessun indirizzo preciso."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados enviados: o seu guarda-roupa (peças, cores, marcas), a meteorologia da sua localização, o seu orçamento e o estilo pretendido. Nenhuma fotografia, nenhuma morada exata."
          }
        }
      }
    },
    "stylisteUI.consentDecline": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer sans mes informations"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue without my details"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne meine Angaben fortfahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar sin mis datos"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua senza i miei dati"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar sem os meus dados"
          }
        }
      }
    },
    "stylisteUI.consentIntro": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour des conseils adaptés, la styliste peut envoyer votre contexte à notre prestataire d'IA. Vous pouvez refuser : elle répondra alors sans ces informations."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For tailored advice, the stylist can send your context to our AI provider. You can decline: it will then answer without that information."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für passende Ratschläge kann die Stylistin Ihren Kontext an unseren KI-Dienstleister senden. Sie können ablehnen: Sie antwortet dann ohne diese Angaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para dar consejos adaptados, la estilista puede enviar tu contexto a nuestro proveedor de IA. Puedes rechazarlo: responderá sin esa información."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per consigli su misura, la stylist può inviare il tuo contesto al nostro fornitore di IA. Puoi rifiutare: risponderà senza queste informazioni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conselhos adaptados, a estilista pode enviar o seu contexto ao nosso fornecedor de IA. Pode recusar: responderá sem essas informações."
          }
        }
      }
    },
    "stylisteUI.consentRecipients": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinataires : OpenAI, puis Google Gemini si OpenAI est indisponible. Ces prestataires traitent les données sur des serveurs situés aux États-Unis, chacun selon sa propre politique de confidentialité."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipients: OpenAI, then Google Gemini if OpenAI is unavailable. These providers process the data on servers located in the United States, each under its own privacy policy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfänger: OpenAI, dann Google Gemini, falls OpenAI nicht verfügbar ist. Diese Dienstleister verarbeiten die Daten auf Servern in den Vereinigten Staaten, jeweils nach ihrer eigenen Datenschutzerklärung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatarios: OpenAI y, si OpenAI no está disponible, Google Gemini. Estos proveedores tratan los datos en servidores ubicados en Estados Unidos, cada uno según su propia política de privacidad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatari: OpenAI, poi Google Gemini se OpenAI non è disponibile. Questi fornitori trattano i dati su server situati negli Stati Uniti, ciascuno secondo la propria informativa sulla privacy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatários: OpenAI e, se a OpenAI estiver indisponível, Google Gemini. Estes fornecedores tratam os dados em servidores localizados nos Estados Unidos, cada um segundo a sua própria política de privacidade."
          }
        }
      }
    },
    "stylisteUI.consentTitle": {
      "extractionState": "manual",
      "localizations": {
