      "comment": "demoGallery › inclusivityMessage",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel ist für alle Menschen konzipiert, unabhängig von Geschlecht, Hautton oder Körpertyp. Schmuck ist universell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel is designed for all people, regardless of gender, skin tone, or body type. Jewelry is universal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel está diseñado para todas las personas, independientemente de su género, tono de piel o tipo de cuerpo. Las joyas son universales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel est conçu pour toutes les personnes, quels que soient leur genre, leur carnation ou leur morphologie. Les bijoux sont universels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel è progettato per tutte le persone, indipendentemente dal genere, dal tono della pelle o dal tipo di corpo. I gioielli sono universali."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Écrin Virtuel foi projetado para todas as pessoas, independentemente de gênero, tom de pele ou tipo de corpo. As joias são universais."
          }
        }
      }
    },
    "demoGallery.inclusivityTitle": {
