      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden Sie Teil von L'Écrin Virtuel und präsentieren Sie Ihren handgefertigten Schmuck Tausenden von Liebhabern. Kostenlose Bewerbung, Antwort innerhalb von 72 Stunden."
