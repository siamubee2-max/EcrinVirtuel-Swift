    "demoGallery.intro" : {
      "comment" : "demoGallery › intro",
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecken Sie, wie sich unser Schmuck an alle Körpertypen und Hauttöne anpasst."
