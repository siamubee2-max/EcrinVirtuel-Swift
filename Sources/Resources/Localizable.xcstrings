    "tryOnUI.consentDeclinedMessage": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayage annulé : sans votre consentement, aucune photo n'est envoyée. Vous pourrez l'accorder au prochain essai."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try-on cancelled: without your consent, no photo is sent. You can grant it the next time you try."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anprobe abgebrochen: Ohne Ihre Zustimmung wird kein Foto gesendet. Sie können sie beim nächsten Versuch erteilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba cancelada: sin tu consentimiento no se envía ninguna foto. Podrás darlo en el próximo intento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova annullata: senza il tuo consenso non viene inviata alcuna foto. Potrai darlo al prossimo tentativo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova cancelada: sem o seu consentimento, nenhuma fotografia é enviada. Poderá dá-lo na próxima tentativa."
          }
        }
      }
    },
    "tryOnUI.consentDeletion": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie temporaire est supprimée de nos serveurs dès la fin de la génération."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The temporary copy is deleted from our servers as soon as the generation is complete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die temporäre Kopie wird nach Abschluss der Generierung sofort von unseren Servern gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia temporal se elimina de nuestros servidores en cuanto termina la generación."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia temporanea viene eliminata dai nostri server non appena la generazione è completata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia temporária é eliminada dos nossos servidores assim que a geração termina."
          }
        }
      }
    },
    "tryOnUI.consentIntro": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de générer votre essayage, nous avons besoin de votre accord pour envoyer votre photo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before generating your try-on, we need your permission to send your photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor wir Ihre Anprobe erstellen, benötigen wir Ihre Zustimmung zum Senden Ihres Fotos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de generar tu prueba, necesitamos tu permiso para enviar tu foto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di generare la tua prova, abbiamo bisogno del tuo consenso per inviare la tua foto."
