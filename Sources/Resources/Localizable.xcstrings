    "partnerUI.applyIntro": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Präsentieren Sie Ihre Kreationen Tausenden von Schmuckliebhabern. Füllen Sie dieses Formular aus — unser Team meldet sich innerhalb von 72 Stunden bei Ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce your creations to thousands of jewelry lovers. Fill out this form — our team will get back to you within 72 hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da a conocer tus creaciones a miles de apasionados de las joyas. Completa este formulario: nuestro equipo te responderá en un plazo de 72 h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites découvrir vos créations à des milliers de passionnés de bijoux. Complétez ce formulaire — notre équipe vous répondra sous 72 h."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai scoprire le tue creazioni a migliaia di appassionati di gioielli. Compila questo modulo: il nostro team ti risponderà entro 72 ore."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê a conhecer as suas criações a milhares de apaixonados por joias. Preencha este formulário — a nossa equipa responder-lhe-á no prazo de 72 h."
          }
        }
      }
    },
