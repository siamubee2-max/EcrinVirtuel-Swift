    "demoGallery.intro": {
      "comment": "demoGallery › intro",
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecken Sie, wie sich unser Schmuck an alle Körpertypen und Hauttöne anpasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover how our jewelry adapts to all body types and skin tones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubre cómo nuestras joyas se adaptan a todos los tipos de cuerpo y tonos de piel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez comment nos bijoux s'adaptent à toutes les morphologies et carnations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri come i nostri gioielli si adattano a tutti i tipi di corpo e tonalità di pelle."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descubra como nossas joias se adaptam a todos os tipos de corpo e tons de pele."
          }
        }
      }
    },
