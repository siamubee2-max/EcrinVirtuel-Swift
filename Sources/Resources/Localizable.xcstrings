    "stoneTherapyUI.wellnessDisclaimer": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu traditionnel proposé à titre informatif et culturel. La lithothérapie n'est pas une pratique médicale reconnue et ne remplace ni un avis, ni un diagnostic, ni un traitement médical."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditional content provided for informational and cultural purposes. Crystal healing is not a recognized medical practice and does not replace medical advice, diagnosis or treatment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Traditionelle Inhalte zu Informations- und Kulturzwecken. Steinheilkunde ist keine anerkannte medizinische Praxis und ersetzt weder ärztlichen Rat noch Diagnose oder Behandlung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido tradicional con fines informativos y culturales. La litoterapia no es una práctica médica reconocida y no sustituye el consejo, el diagnóstico ni el tratamiento médico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuto tradizionale a scopo informativo e culturale. La cristalloterapia non è una pratica medica riconosciuta e non sostituisce il parere, la diagnosi o il trattamento medico."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo tradicional com fins informativos e culturais. A litoterapia não é uma prática médica reconhecida e não substitui aconselhamento, diagnóstico ou tratamento médico."
          }
        }
      }
    },
